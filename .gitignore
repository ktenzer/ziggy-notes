# =============================================================================
# Ziggy Listens — Swift / Xcode macOS app
# =============================================================================

# Shipped pre-config with secrets (baked into local builds, kept out of git).
# Copy ZiggyDefaults.example.plist -> ZiggyDefaults.plist and fill it in.
ui/ZiggyNotes/ZiggyDefaults.plist

# Meeting summary output folder (default outputDir is <project>/out)
out/

# -----------------------------------------------------------------------------
# Build artifacts
# -----------------------------------------------------------------------------

# Swift Package Manager build artifacts, resolved dependency checkouts, and the
# xcodebuild derivedDataPath (build_dmg.sh builds into ui/.build).
.build/
.swiftpm/
DerivedData/

# Generated Xcode project. XcodeGen regenerates it from ui/project.yml
# (`xcodegen generate`), so project.yml is the source of truth, not the pbxproj.
ui/*.xcodeproj/

# Xcode user-specific state and build caches
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap

# Build / archive products
*.app
*.ipa
*.dSYM
*.dSYM.zip

# DMG and generated icon artifacts (build_dmg.sh output; the final DMG lands in
# ~/Documents, but ignore any that end up in the tree)
*.dmg
*.icns

# -----------------------------------------------------------------------------
# Editor / OS
# -----------------------------------------------------------------------------
# .vscode/
# .idea/
.DS_Store
